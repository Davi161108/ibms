    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        
        // Revelar todos elementos scroll-fade-up
        const scrollUpElements = document.querySelectorAll('.scroll-fade-up');
        function revealUp() {
            scrollUpElements.forEach(el => {
                const rect = el.getBoundingClientRect();
                if (rect.top < window.innerHeight - 100) {
                    el.classList.add('visible');
                }
            });
        }
        window.addEventListener('scroll', revealUp);
        revealUp();



        document.querySelectorAll('a[href^="#"]').forEach(link => {
            link.addEventListener('click', function (e) {
                const target = document.querySelector(this.getAttribute('href'));

                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        document.getElementById('seta').addEventListener('click', function () {
            document.querySelector('#nossa').scrollIntoView({ behavior: 'smooth' });
        });
    </script>
